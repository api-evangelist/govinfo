      "name": "Search",
      "description": {
        "content": "Discover documents on GovInfo using search queries and field operators available in the GovInfo UI",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "c9e40f82-4eed-4d2f-884e-82fce20b3051",
          "name": "search",
          "request": {
            "name": "search",
            "description": {
              "content": "This service can be used to query the GovInfo search engine and return results that are the equivalent to what is returned by the main user interface. You can use field operators, such as congress, publishdate, branch, and others to construct complex queries that will return only matching documents. For additional information, please see our <a href='https://www.govinfo.gov/features/search-service-overview' target='blank' style='text-decoration:underline'>search service overview</a>.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "api_key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "query"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"<string>\",\n  \"pageSize\": \"<integer>\",\n  \"offsetMark\": \"<string>\",\n  \"sorts\": [\n    {\n      \"field\": \"<string>\",\n      \"sortOrder\": \"<string>\"\n    },\n    {\n      \"field\": \"<string>\",\n      \"sortOrder\": \"<string>\"\n    }\n  ],\n  \"historical\": \"<boolean>\",\n  \"resultLevel\": \"<string>\"\n}",
